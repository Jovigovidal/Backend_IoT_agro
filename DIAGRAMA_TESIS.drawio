        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Definición de Estilos Profesionales\n    classDef hardware fill:#2d3436,stroke:#0984e3,stroke-width:3px,color:#fff,rx:10,ry:10;\n    classDef cloud fill:#74b9ff,stroke:#0984e3,stroke-width:3px,color:#2d3436,rx:15,ry:15;\n    classDef dockerNode fill:#00b894,stroke:#00cec9,stroke-width:3px,color:#fff,rx:8,ry:8;\n    classDef dbNode fill:#fdcb6e,stroke:#e17055,stroke-width:3px,color:#2d3436,rx:8,ry:8;\n    classDef tunnel fill:#a29bfe,stroke:#6c5ce7,stroke-width:3px,color:#fff,rx:10,ry:10;\n\n    subgraph \&quot;🌐 Clientes Externos (Internet)\&quot;\n        ESP32[\&quot;fa:fa-microchip Microcontrolador ESP32-S3&lt;br/&gt;(Sensores y Relés)\&quot;]:::hardware\n        USUARIO[\&quot;fa:fa-laptop Usuario / Administrador&lt;br/&gt;(Navegador Web)\&quot;]:::hardware\n    end\n\n    subgraph \&quot;☁️ Zrok Cloud / Internet\&quot;\n        ZROK_CLOUD((\&quot;fa:fa-cloud Zrok Network&lt;br/&gt;(URL Pública HTTPS)\&quot;)):::cloud\n    end\n\n    subgraph \&quot;🐧 Servidor Local (Host Linux)\&quot;\n        direction TB\n        ZROK_CLIENT{\&quot;fa:fa-shield-alt Zrok Client&lt;br/&gt;(Túnel Seguro)\&quot;}:::tunnel\n        \n        subgraph \&quot;🐳 Ecosistema Docker (Red Interna: 172.x.x.x)\&quot;\n            direction LR\n            FRONTEND[\&quot;fa:fa-cubes Contenedor Angular&lt;br/&gt;(Puerto 80)\&quot;]:::dockerNode\n            BACKEND[\&quot;fa:fa-cogs Contenedor Laravel&lt;br/&gt;(Puerto 8000)\&quot;]:::dockerNode\n            DB[(\&quot;fa:fa-database Contenedor MySQL&lt;br/&gt;(Puerto 3306)\&quot;)]:::dbNode\n            \n            FRONTEND -. \&quot;fa:fa-exchange-alt API REST\&quot; .-&gt; BACKEND\n            BACKEND &lt;== \&quot;fa:fa-server Lectura/Escritura\&quot; ==&gt; DB\n        end\n        \n        ZROK_CLIENT ===|\&quot;Redirección local\&quot;| FRONTEND\n        ZROK_CLIENT ===|\&quot;Redirección local\&quot;| BACKEND\n    end\n\n    %% Conexiones principales\n    ESP32 --&gt;|\&quot;POST/GET (JSON)\&quot;| ZROK_CLOUD\n    USUARIO --&gt;|\&quot;HTTPS\&quot;| ZROK_CLOUD\n    ZROK_CLOUD ===|\&quot;fa:fa-lock Túnel Encriptado\&quot;| ZROK_CLIENT\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="639XBa-bMxHbPkgE7c4O-20">
